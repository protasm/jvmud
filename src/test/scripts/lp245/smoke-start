#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd)
cd "$ROOT_DIR"

# Keep directory listeners independent of the mudlib's direct player endpoint.
read -r ENGINE_PORT ADMIN_PORT < <(python3 - <<'PORTS'
import socket
with socket.socket() as player, socket.socket() as admin:
    player.bind(("127.0.0.1", 0))
    admin.bind(("127.0.0.1", 0))
    print(player.getsockname()[1], admin.getsockname()[1])
PORTS
)

# Keep all generated state in a disposable world under the build directory.
mkdir -p "$ROOT_DIR/target/test-artifacts"
RUN_DIR=$(mktemp -d "$ROOT_DIR/target/test-artifacts/lp245.XXXXXX")
LOG_FILE="$RUN_DIR/listener.log"
SERVER_PID=
STATE_DIR=$(mktemp -d /tmp/jvmud-smoke.XXXXXX)

cleanup() {
  status=$1
  if [[ -n "${SERVER_PID}" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  python3 - "$STATE_DIR" <<'CLEANUP'
from pathlib import Path
import shutil
import sys
shutil.rmtree(Path(sys.argv[1]))
CLEANUP
  if [[ "$status" -eq 0 ]]; then
    rm -rf "$RUN_DIR"
  else
    echo "listener log: $LOG_FILE" >&2
  fi
}
trap 'status=$?; cleanup "$status"; exit "$status"' EXIT

cp -R "$ROOT_DIR/mudlibs/lp245" "$RUN_DIR/world"
# Only the disposable copy receives writable directories for player state.
find "$RUN_DIR/world" -type d -exec chmod u+w {} +
python3 - "$RUN_DIR/world/players" <<'SAVE'
from pathlib import Path
import sys
(Path(sys.argv[1]) / "smoketest.o").unlink(missing_ok=True)
SAVE

scripts/jvmud-start --port "$ENGINE_PORT" --admin-port "$ADMIN_PORT" \
  --state-dir "$STATE_DIR" "$RUN_DIR/world/jvmud/lp245.config" >"$LOG_FILE" 2>&1 &
SERVER_PID=$!

python3 - "$LOG_FILE" <<'PY'
from pathlib import Path
import re
import socket
import sys
import time

log = Path(sys.argv[1])
deadline = time.monotonic() + 45
while True:
    report = log.read_text()
    match = re.search(r"state=RUNNING, playerPort=(\d+)", report)
    if match:
        port = int(match[1])
        break
    if time.monotonic() >= deadline:
        raise AssertionError("Mudlib did not become ready:\n" + report)
    time.sleep(0.1)


def connect_with_retry(deadline_seconds=30):
    deadline = time.monotonic() + deadline_seconds
    last_error = None
    while time.monotonic() < deadline:
        try:
            sock = socket.create_connection(("127.0.0.1", port), timeout=1)
            sock.settimeout(5)
            return sock
        except OSError as exc:
            last_error = exc
            time.sleep(0.25)
    raise RuntimeError(f"listener did not accept a connection: {last_error}")


# A failed smoke run retains the response history beside the listener log.
transcript_file = log.with_name("transcript.log")
PROMPT = re.compile(r"(?:^|\n)> ")


def record(text):
    with transcript_file.open("a") as output:
        output.write(text)


def read_until_any(sock, markers, timeout=8):
    deadline = time.monotonic() + timeout
    chunks = []
    while time.monotonic() < deadline:
        try:
            data = sock.recv(4096)
        except socket.timeout:
            continue
        if not data:
            break
        chunks.append(data.decode("utf-8", errors="replace"))
        transcript = "".join(chunks)
        if any(marker in transcript if isinstance(marker, str) else marker.search(transcript)
               for marker in markers):
            record(transcript)
            return transcript
    transcript = "".join(chunks)
    record(transcript)
    raise AssertionError(
        f"Missing response marker {markers!r}:\n{transcript}\n"
        f"Full transcript: {transcript_file}")


def read_until(sock, marker):
    return read_until_any(sock, [marker])


def read_tail(sock, idle_seconds=0.05):
    chunks = []
    original_timeout = sock.gettimeout()
    sock.settimeout(idle_seconds)
    try:
        while True:
            try:
                data = sock.recv(4096)
            except socket.timeout:
                break
            if not data:
                break
            chunks.append(data.decode("utf-8", errors="replace"))
    finally:
        sock.settimeout(original_timeout)
    transcript = "".join(chunks)
    record(transcript)
    return transcript


def command(sock, line, *expected):
    """Read the line-start prompt; help text can contain an unrelated ``> `` inside markup."""
    record(f"\n>>> {line}\n")
    sock.sendall((line + "\n").encode())
    transcript = read_until_any(sock, [PROMPT])
    if "Error:" in transcript or "You can't do that." in transcript:
        raise AssertionError(f"Command {line!r} reported an error:\n{transcript}")
    for marker in expected:
        if marker not in transcript:
            raise AssertionError(f"Command {line!r} omitted {marker!r}:\n{transcript}")
    return transcript


def move_and_look(sock, direction, description):
    """Check movement and the room itself, independent of the player's brief display policy."""
    command(sock, direction)
    command(sock, "look", description)


def log_in(sock, name):
    transcript = read_until(sock, "What is your name: ") + read_tail(sock)
    if "JVMud telnet." not in transcript:
        raise AssertionError(f"missing telnet greeting:\n{transcript}")
    if "What is your name: " not in transcript:
        raise AssertionError(f"vanilla player logon did not capture initial input:\n{transcript}")
    if "What is your name: > " in transcript:
        raise AssertionError(f"command prompt was emitted while mudlib login input was pending:\n{transcript}")

    record(f"\nLogin: {name}\n")
    sock.sendall((name + "\n").encode())
    transcript = read_until(sock, "Password: ") + read_tail(sock)
    if "New character." not in transcript:
        raise AssertionError(f"logon name input did not reach obj/player.logon2:\n{transcript}")
    if "Password: " not in transcript:
        raise AssertionError(f"logon name input did not request a password:\n{transcript}")
    if "Password: > " in transcript:
        raise AssertionError(f"telnet layer appended a prompt to the mudlib password prompt:\n{transcript}")

    sock.sendall(b"secret1\n")
    transcript = read_until(sock, "Password: (again) ") + read_tail(sock)
    if "Password: (again) " not in transcript:
        raise AssertionError(f"first password input did not request confirmation:\n{transcript}")
    if "Password: (again) > " in transcript:
        raise AssertionError(f"telnet layer appended a prompt to the mudlib password prompt:\n{transcript}")

    sock.sendall(b"secret1\n")
    transcript = read_until(sock, "Please enter your email address")
    if "Please enter your email address" not in transcript:
        raise AssertionError(f"password confirmation did not request email:\n{transcript}")

    sock.sendall(b"none\n")
    transcript = read_until(sock, "Are you, male, female or other")
    if "Are you, male, female or other" not in transcript:
        raise AssertionError(f"email input did not request gender:\n{transcript}")

    sock.sendall(b"o\n")
    transcript = read_until(sock, "Welcome, Creature!")
    if "Welcome, Creature!" not in transcript:
        raise AssertionError(f"gender input did not complete login:\n{transcript}")
    prompt = transcript if "> " in transcript else read_until(sock, "> ")
    if "> " not in prompt:
        raise AssertionError(f"configured mudlib command prompt did not appear after login:\n{transcript}{prompt}")


def disconnect(sock):
    record("\n>>> //quit\n")
    sock.sendall(b"//quit\n")
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            data = sock.recv(4096)
        except socket.timeout:
            continue
        if not data:
            break
        record(data.decode("utf-8", errors="replace"))
    else:
        raise AssertionError("Transport quit did not close the connection.")


with connect_with_retry() as sock:
    log_in(sock, "smoketest")
    command(sock, "look", "You are in the local village church.")
    for direction, description in [
            ("south", "You are at an open green place south of the village church."),
            ("east", "A track going into the village."),
            ("east", "A long road going east through the village."),
            ("east", "south is the adventurers guild"),
            ("south", "You have to come here when you want to advance your level.")]:
        move_and_look(sock, direction, description)

    command(sock, "cost", "Str: ", "gold coins to advance to level")
    command(sock, "exa book", "There is a book hanging in a chain from the wall.")

    for direction, description in [
            ("north", "south is the adventurers guild"),
            ("west", "A long road going east through the village."),
            ("west", "A track going into the village."),
            ("west", "You are at an open green place south of the village church."),
            ("west", "An old humpbacked bridge.")]:
        move_and_look(sock, direction, description)

    command(sock, "get all", "Ok.")
    transcript = command(sock, "light stick")
    if "Ok." not in transcript and "You can see again." not in transcript:
        raise AssertionError(f"Carried stick did not expose its light action:\n{transcript}")
    command(sock, "help", "COMMUNICATIONS:", "OTHER TOPICS:")

    for direction, description in [
            ("west", "You are in the wilderness outside the village."),
            ("west", "You are in a big forest."),
            ("west", "A small clearing. There are trees all around you."),
            ("west", "You are in a big forest.")]:
        move_and_look(sock, direction, description)

    command(sock, "exa troll", "It is a nasty troll that look very aggressive.")
    for direction, description in [
            ("west", "The forest gets light here, and slopes down to the west."),
            ("west", "You are in the orc valley. This place is inhabited by orcs."),
            ("north", "This is the local strong point of the orcs.")]:
        move_and_look(sock, direction, description)

    command(sock, "look", "This is the local strong point of the orcs.")
    move_and_look(sock, "south", "You are in the orc valley. This place is inhabited by orcs.")
    move_and_look(sock, "east", "The forest gets light here, and slopes down to the west.")

    disconnect(sock)

PY

echo "LP245 JVMud start smoke passed"

# JVMud mudlib configuration.
#
# This manifest declares how this mudlib accepts JVMud's core commitments at
# startup. JVMud owns the engine concepts; this file maps mudlib vocabulary
# and compatibility policy onto them.

# Normalize legacy declarations in memory before strict compilation.
transpilation.untyped_methods = true
# Override file is relative to this manifest; targets are relative to mudlib_root.
transpilation.overrides = transpilation.json

game_id = lp245
game_name = Lysator LP 2.4.5
language_features = protected_evaluation, typed_function_literals, inline_callables, multi_value_mappings, varargs
engine_capabilities = mudlib_files, session_control, host_control
mudlib_root = ..
include_paths = obj, room

mudlib_object = jvmud/mudlib
mfun_object = jvmud/mfuns
player_object = obj/player
player_prompt = "> "
presentation.connected_banner = JVMud telnet. Type //help for commands or //quit to disconnect.
transport.control_prefix = //

initial_place = room/church

preload_file = room/init_file
preload_objects =

lifecycle.object_loaded = reset
lifecycle.object_source_missing = compile_object
lifecycle.object_destruction_requested = prepare_destruct
lifecycle.interaction_scope_started = init
lifecycle.player_session_connected = logon
lifecycle.player_session_disconnected = quit
lifecycle.log_error = log_error
lifecycle.runtime_error = runtime_error
lifecycle.scheduled_tick_error = heart_beat_error
lifecycle.server_shutdown = notify_shutdown

temporal_tick_method = heart_beat
temporal_tick_interval = 1

# Direct name mappings preserve native signatures and sscanf output captures.
engine_function.jvmud_split_text = explode
engine_function.jvmud_append_mudlib_text = write_file
engine_function.jvmud_sscanf = sscanf

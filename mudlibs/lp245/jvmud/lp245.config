# JVMud mudlib configuration.
#
# This manifest declares how this mudlib accepts JVMud's core commitments at
# startup. JVMud owns the engine concepts; this file maps mudlib vocabulary
# and compatibility policy onto them.

game_id = vanilla-lpmud-245
game_name = Vanilla LPMUD 2.4.5
mudlib_root = ../source

mudlib_object = jvmud/mudlib
mfun_object = jvmud/mfuns
player_object = obj/player
player_prompt = "> "

initial_place = room/church

preload_file = room/init_file
preload_objects =

lifecycle.object_loaded = reset
lifecycle.object_destruction_requested = prepare_destruct
lifecycle.interaction_scope_started = init
lifecycle.player_session_connected = logon
lifecycle.player_session_disconnected = quit
lifecycle.log_error = log_error
lifecycle.runtime_error = runtime_error
lifecycle.scheduled_tick_error = heart_beat_error
lifecycle.server_shutdown = notify_shutdown

temporal_tick_method = heart_beat
temporal_tick_interval = 1

# JVMud mudlib configuration.
#
# This manifest declares how RealmsMUD accepts JVMud's core commitments at
# startup. JVMud owns the engine concepts; this file maps RealmsMUD's LDMud
# vocabulary and compatibility policy onto them.

game_id = realmsmud
game_name = RealmsMUD
mudlib_root = ../source

mudlib_object = jvmud/mudlib
mfun_object = jvmud/mfuns
player_object = secure/login
player_prompt = >
max_line_length = 78
show_ruler = false

initial_place = areas/eledhel/southern-city/12x2

preload_file = init/init_file
preload_objects = secure/master, secure/simul_efun

direct_efun.sizeof = jvmud_size
direct_efun.db_connect = jvmud_db_connect
direct_efun.db_exec = jvmud_db_exec
direct_efun.db_fetch = jvmud_db_fetch
direct_efun.db_error = jvmud_db_error
direct_efun.db_close = jvmud_db_close
direct_efun.db_handles = jvmud_db_handles
direct_efun.db_conv_string = jvmud_db_escape
direct_efun.users = jvmud_users
direct_efun.this_object = jvmud_current_entity
direct_efun.this_player = jvmud_this_player
direct_efun.previous_object = jvmud_previous_object
direct_efun.interactive = jvmud_interactive
direct_efun.interactive_info = jvmud_interactive_info
direct_efun.object_info = jvmud_object_info
direct_efun.configure_object = jvmud_configure_object
direct_efun.find_object = jvmud_find_object
direct_efun.shutdown = jvmud_shutdown
direct_efun.set_this_player = jvmud_set_this_player
direct_efun.raise_error = jvmud_raise_error
direct_efun.read_file = jvmud_read_mudlib_text
direct_efun.get_dir = jvmud_list_mudlib_paths
direct_efun.explode = jvmud_split_text
direct_efun.regreplace = jvmud_regex_replace
direct_efun.to_int = jvmud_to_int
direct_efun.m_indices = jvmud_mapping_keys
direct_efun.lower_case = jvmud_lowercase_text
direct_efun.upper_case = jvmud_uppercase_text

database.url = jdbc:mysql://localhost:3306/RealmsLib
database.user = realmslib
database.password = 842e929e469b4f13a8a71108229a45b6

# LDMud compatibility predefines. These satisfy RealmsMUD driver-version probes
# without making LDMud's predefined macro vocabulary part of JVMud-native LPC.
ldmud_compat_predefine.__VERSION__ = "JVMud RealmsMUD LDMud compatibility"
ldmud_compat_predefine.__VERSION_MAJOR__ = 3
ldmud_compat_predefine.__VERSION_MINOR__ = 6
ldmud_compat_predefine.__VERSION_MICRO__ = 3
ldmud_compat_function_predefine.__EFUN_DEFINED__.text_width = 0

lifecycle.object_loaded = create
lifecycle.object_activated = reset
lifecycle.object_destruction_requested = prepare_destruct
lifecycle.player_session_connected = logon
lifecycle.log_error = log_error
lifecycle.runtime_error = runtime_error

# RealmsMUD does not currently expose safe direct matches for these JVMud hooks:
# lifecycle.object_source_missing
# lifecycle.interaction_scope_started
# lifecycle.player_session_disconnected
# lifecycle.scheduled_tick_error
# lifecycle.server_shutdown

temporal_tick_method = heart_beat
temporal_tick_interval = 1

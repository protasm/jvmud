# JVMud mudlib configuration.
#
# This manifest declares how RealmsMUD accepts JVMud's core commitments at
# startup. JVMud owns the engine concepts; this file maps RealmsMUD's LDMud
# vocabulary and compatibility policy onto them.

game_id = realmsmud
game_name = RealmsMUD
mudlib_root = ../source

mudlib_object = jvmud/mudlib
mfun_object = secure/simul_efun
compatibility_object = jvmud/compat
player_object = secure/login
player_prompt = >
max_line_length = 78
show_ruler = false

initial_place = areas/eledhel/southern-city/12x2

preload_file = init/init_file
preload_objects = secure/master, secure/simul_efun, lib/services/environmentService

engine_function.jvmud_size = sizeof
engine_function.jvmud_format_text = sprintf
engine_function.jvmud_allocate = allocate
engine_function.jvmud_db_connect = db_connect
engine_function.jvmud_db_exec = db_exec
engine_function.jvmud_db_fetch = db_fetch
engine_function.jvmud_db_error = db_error
engine_function.jvmud_db_close = db_close
engine_function.jvmud_db_handles = db_handles
engine_function.jvmud_db_escape = db_conv_string
engine_function.jvmud_users = users
engine_function.jvmud_find_player = findPlayer
engine_function.jvmud_add_action = add_action
engine_function.jvmud_enable_commands = enable_commands
engine_function.jvmud_rebind_session_lpc_object = exec
engine_function.jvmud_invoke_lpc_object = call_other, call_direct
engine_function.jvmud_write_to_lpc_object = tell_object
engine_function.jvmud_current_lpc_object = this_object
engine_function.jvmud_current_agent = this_player
engine_function.jvmud_previous_object = previous_object
engine_function.jvmud_current_verb = query_verb, query_command
engine_function.jvmud_interactive = interactive
engine_function.jvmud_interactive_info = interactive_info
engine_function.jvmud_query_idle = query_idle
engine_function.jvmud_query_ip_number = query_ip_number
engine_function.jvmud_query_ip_name = query_ip_name
engine_function.jvmud_lpc_object_info = object_info
engine_function.jvmud_lpc_object_id = object_name
engine_function.jvmud_configure_lpc_object = configure_object
engine_function.jvmud_find_lpc_object = find_object, blueprint
engine_function.jvmud_to_lpc_object = to_object
engine_function.jvmud_method_exists = function_exists
engine_function.jvmud_shutdown = shutdown
engine_function.jvmud_set_this_player = set_this_player
engine_function.jvmud_raise_error = raise_error
engine_function.jvmud_move_entity = move_object
engine_function.jvmud_set_entity_location = set_environment
engine_function.jvmud_entity_location = environment
engine_function.jvmud_read_mudlib_text = read_file
engine_function.jvmud_remove_mudlib_text = rm
engine_function.jvmud_copy_mudlib_text = copy_file
engine_function.jvmud_rename_mudlib_text = rename
engine_function.jvmud_remove_mudlib_directory = rmdir
engine_function.jvmud_list_mudlib_paths = get_dir
engine_function.jvmud_split_text = explode
engine_function.jvmud_load_lpc_object = load_object
engine_function.jvmud_clone_lpc_object = clone_object
engine_function.jvmud_destroy_lpc_object = destruct
engine_function.jvmud_find_entity = present
engine_function.jvmud_regex_match = regexp
engine_function.jvmud_regex_replace = regreplace
engine_function.jvmud_regex_explode = regexplode
engine_function.jvmud_remove_action = remove_action
engine_function.jvmud_driver_info = driver_info
engine_function.jvmud_notify_fail = notify_fail
engine_function.jvmud_capture_session_input = input_to
engine_function.jvmud_to_int = to_int
engine_function.jvmud_to_string = to_string
engine_function.jvmud_time = time
engine_function.jvmud_sqrt = sqrt
engine_function.jvmud_write = write
engine_function.jvmud_emit_perceivable_at = tell_room
engine_function.jvmud_member = member
engine_function.jvmud_mapping_keys = m_indices
engine_function.jvmud_mapping_values = m_values
engine_function.jvmud_mapping_from_keys = mkmapping
engine_function.jvmud_mapping_delete = m_delete
engine_function.jvmud_inherited_programs = inherit_list
engine_function.jvmud_serialize_lpc_value = save_value
engine_function.jvmud_deserialize_lpc_value = restore_value
engine_function.jvmud_schedule_deferred_callback = call_out
engine_function.jvmud_cancel_deferred_callback = remove_call_out
engine_function.jvmud_wrap_text = format
engine_function.jvmud_apply_callable = apply
engine_function.jvmud_filter = filter
engine_function.jvmud_filter_indices = filter_indices
engine_function.jvmud_map = map
engine_function.jvmud_sort_array = sort_array
engine_function.jvmud_sscanf = sscanf
engine_function.jvmud_random = random
engine_function.jvmud_lowercase_text = lower_case
engine_function.jvmud_uppercase_text = upper_case
engine_function.jvmud_capitalize_text = capitalize
engine_function.jvmud_is_mapping = mappingp
engine_function.jvmud_is_object = objectp
engine_function.jvmud_is_array = pointerp
engine_function.jvmud_is_string = stringp
engine_function.jvmud_is_int = intp
engine_function.jvmud_is_float = floatp
engine_function.jvmud_set_driver_hook = set_driver_hook

database.url = jdbc:mysql://127.0.0.1:3306/RealmsLib
database.user = realmslib
database.password = 6c629eb417c941609710295492275ed3

# LDMud compatibility predefines. These satisfy RealmsMUD driver-version probes
# without making LDMud's predefined macro vocabulary part of JVMud-native LPC.
ldmud_compat_predefine.__VERSION__ = "JVMud RealmsMUD LDMud compatibility"
ldmud_compat_predefine.__VERSION_MAJOR__ = 3
ldmud_compat_predefine.__VERSION_MINOR__ = 6
ldmud_compat_predefine.__VERSION_MICRO__ = 3
ldmud_compat_function_predefine.__EFUN_DEFINED__.text_width = 0

lifecycle.object_loaded = create
lifecycle.object_activated = reset
lifecycle.object_destruction_requested = prepare_destruct
lifecycle.player_session_connected = logon
lifecycle.player_session_post_rebind = addCommands
lifecycle.interaction_scope_started = init
lifecycle.log_error = log_error
lifecycle.runtime_error = runtime_error

# RealmsMUD does not currently expose safe direct matches for these JVMud hooks:
# lifecycle.object_source_missing
# lifecycle.player_session_disconnected
# lifecycle.scheduled_tick_error
# lifecycle.server_shutdown

temporal_tick_method = heart_beat
temporal_tick_interval = 1

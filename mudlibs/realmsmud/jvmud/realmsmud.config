# JVMud mudlib configuration.
#
# This manifest declares how RealmsMUD accepts JVMud's core commitments at
# startup. JVMud owns the engine concepts; this file maps RealmsMUD's LDMud
# vocabulary and compatibility policy onto them.

game_id = realmsmud
game_name = RealmsMUD
mudlib_root = ../source

mudlib_object = jvmud/mudlib
mudlib_global_object = secure/simul_efun
player_object = secure/login
player_prompt = >
max_line_length = 78
show_ruler = false

initial_place = areas/eledhel/southern-city/12x2

preload_file = init/init_file
preload_objects = secure/master, secure/simul_efun, lib/services/environmentService

engine_function.sizeof = jvmud_size
engine_function.sprintf = jvmud_format_text
engine_function.allocate = jvmud_allocate
engine_function.db_connect = jvmud_db_connect
engine_function.db_exec = jvmud_db_exec
engine_function.db_fetch = jvmud_db_fetch
engine_function.db_error = jvmud_db_error
engine_function.db_close = jvmud_db_close
engine_function.db_handles = jvmud_db_handles
engine_function.db_conv_string = jvmud_db_escape
engine_function.users = jvmud_users
engine_function.findPlayer = jvmud_find_player
engine_function.tell_object = jvmud_write_to_lpc_object
engine_function.this_object = jvmud_current_lpc_object
engine_function.this_player = jvmud_current_agent
engine_function.previous_object = jvmud_previous_object
engine_function.interactive = jvmud_interactive
engine_function.interactive_info = jvmud_interactive_info
engine_function.query_ip_number = jvmud_query_ip_number
engine_function.query_ip_name = jvmud_query_ip_name
engine_function.object_info = jvmud_lpc_object_info
engine_function.configure_object = jvmud_configure_lpc_object
engine_function.find_object = jvmud_find_lpc_object
engine_function.blueprint = jvmud_find_lpc_object
engine_function.to_object = jvmud_to_lpc_object
engine_function.function_exists = jvmud_method_exists
engine_function.shutdown = jvmud_shutdown
engine_function.set_this_player = jvmud_set_this_player
engine_function.raise_error = jvmud_raise_error
engine_function.set_environment = jvmud_set_entity_location
engine_function.environment = jvmud_entity_location
engine_function.read_file = jvmud_read_mudlib_text
engine_function.rm = jvmud_remove_mudlib_text
engine_function.copy_file = jvmud_copy_mudlib_text
engine_function.rename = jvmud_rename_mudlib_text
engine_function.rmdir = jvmud_remove_mudlib_directory
engine_function.get_dir = jvmud_list_mudlib_paths
engine_function.explode = jvmud_split_text
engine_function.load_object = jvmud_load_lpc_object
engine_function.clone_object = jvmud_clone_lpc_object
engine_function.destruct = jvmud_destroy_lpc_object
engine_function.present = jvmud_find_entity
engine_function.regexp = jvmud_regex_match
engine_function.regreplace = jvmud_regex_replace
engine_function.driver_info = jvmud_driver_info
engine_function.to_int = jvmud_to_int
engine_function.to_string = jvmud_to_string
engine_function.sqrt = jvmud_sqrt
engine_function.member = jvmud_member
engine_function.m_indices = jvmud_mapping_keys
engine_function.m_values = jvmud_mapping_values
engine_function.mkmapping = jvmud_mapping_from_keys
engine_function.m_delete = jvmud_mapping_delete
engine_function.inherit_list = jvmud_inherited_programs
engine_function.save_value = jvmud_serialize_lpc_value
engine_function.restore_value = jvmud_deserialize_lpc_value
engine_function.apply = jvmud_apply_callable
engine_function.filter = jvmud_filter
engine_function.map = jvmud_map
engine_function.sort_array = jvmud_sort_array
engine_function.random = jvmud_random
engine_function.lower_case = jvmud_lowercase_text
engine_function.upper_case = jvmud_uppercase_text
engine_function.capitalize = jvmud_capitalize_text
engine_function.mappingp = jvmud_is_mapping
engine_function.objectp = jvmud_is_object
engine_function.pointerp = jvmud_is_array
engine_function.stringp = jvmud_is_string
engine_function.floatp = jvmud_is_float
engine_function.set_driver_hook = jvmud_set_driver_hook

database.url = jdbc:mysql://localhost:3306/RealmsLib
database.user = realmslib
database.password = 6c629eb417c941609710295492275ed3

# LDMud compatibility predefines. These satisfy RealmsMUD driver-version probes
# without making LDMud's predefined macro vocabulary part of JVMud-native LPC.
ldmud_compat_predefine.__VERSION__ = "JVMud RealmsMUD LDMud compatibility"
ldmud_compat_predefine.__VERSION_MAJOR__ = 3
ldmud_compat_predefine.__VERSION_MINOR__ = 6
ldmud_compat_predefine.__VERSION_MICRO__ = 3
ldmud_compat_function_predefine.__EFUN_DEFINED__.text_width = 0

lifecycle.object_loaded = create
lifecycle.object_activated = reset
lifecycle.object_destruction_requested = prepare_destruct
lifecycle.player_session_connected = logon
lifecycle.player_session_post_rebind = addCommands
lifecycle.interaction_scope_started = init
lifecycle.log_error = log_error
lifecycle.runtime_error = runtime_error

# RealmsMUD does not currently expose safe direct matches for these JVMud hooks:
# lifecycle.object_source_missing
# lifecycle.player_session_disconnected
# lifecycle.scheduled_tick_error
# lifecycle.server_shutdown

temporal_tick_method = heart_beat
temporal_tick_interval = 1

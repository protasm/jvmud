# Native JVMud mudlib configuration.
#
# LPMuseum is the free-standing Telnet entrypoint. Exhibit mudlibs are
# subordinate destinations; they do not own the primary login/session flow.

game_id = lpmuseum
game_name = LPMuseum
language_features = protected_evaluation, typed_function_literals, inline_callables, multi_value_mappings, varargs
engine_capabilities = mudlib_files, session_control, host_control
mudlib_root = ../source

mfun_object = jvmud/mfuns
persona_object = persona/visitor
session_policy = lpmuseum_accounts
player_prompt = "> "
presentation.connected_banner = JVMud telnet. Type //help for commands or //quit to disconnect.
transport.control_prefix = //
max_line_length = 80
show_ruler = true

initial_place = place/concourse
mount.vanilla-lpmud-245 = ../../lp245/jvmud/lp245.config

preload_objects = system/help, system/socials, place/concourse, place/origins, place/workshop, place/archive, place/portal_hall, entity/directory, entity/docent, entity/engine_model, entity/archive_case, entity/portal, entity/staffer

lifecycle.object_loaded = reset
lifecycle.interaction_scope_started = init
lifecycle.player_session_connected = connect
lifecycle.player_session_disconnected = disconnect

temporal_tick_method = heart_beat
temporal_tick_interval = 1

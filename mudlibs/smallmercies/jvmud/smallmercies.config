game_id = smallmercies
game_name = Small Mercies
mudlib_root = ../source
persona_object = player/adventurer
initial_place = room/square
engine_capabilities = session_control
player_prompt = "> "
presentation.connected_banner = Small Mercies: great deeds, modest parking.
transport.control_prefix = //
show_ruler = false
preload_objects = room/square, room/inn, room/garden, room/lane, room/cellar, npc/villager, player/adventurer
lifecycle.object_loaded = create
lifecycle.interaction_scope_started = init
lifecycle.player_session_connected = connect
lifecycle.player_session_disconnected = disconnect
temporal_tick_method = tick
temporal_tick_interval = 1

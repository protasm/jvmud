#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"

mvn -q -pl server -am compile dependency:build-classpath \
  -Dmdep.outputFile=target/jvmud-server-classpath.txt >/dev/null

CP="server/target/classes:compiler/target/classes:runtime/target/classes:$(cat server/target/jvmud-server-classpath.txt)"
exec java -cp "$CP" io.github.protasm.jvmud.server.TelnetServer "$@"

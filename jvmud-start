#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"

mvn -q compile dependency:build-classpath \
  -Dmdep.outputFile=target/jvmud-server-classpath.txt >/dev/null

CP="target/classes:$(cat target/jvmud-server-classpath.txt)"
exec java -cp "$CP" io.github.protasm.jvmud.server.TelnetServer "$@"

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.protasm.jvmud</groupId>
  <artifactId>jvmud-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>JVMud</name>
  <description>Experimental Java-based LPMud platform.</description>

  <modules>
    <module>runtime</module>
    <module>compiler</module>
    <module>server</module>
    <module>cli</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <asm.version>9.7.1</asm.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>site-docs</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doctitle>JVMud Compiler and Engine API</doctitle>
              <windowtitle>JVMud API</windowtitle>
              <outputDirectory>${maven.multiModuleProjectDirectory}/docs/api</outputDirectory>
              <sourcepath>${maven.multiModuleProjectDirectory}/runtime/src/main/java:${maven.multiModuleProjectDirectory}/compiler/src/main/java</sourcepath>
              <subpackages>io.github.protasm.jvmud.runtime:io.github.protasm.jvmud.compiler.pipeline:io.github.protasm.jvmud.compiler.efun:io.github.protasm.jvmud.compiler.engine:io.github.protasm.jvmud.compiler.exec:io.github.protasm.jvmud.compiler.runtime</subpackages>
              <source>${maven.compiler.release}</source>
              <doclint>all,-missing</doclint>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
